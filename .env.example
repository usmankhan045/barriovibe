# Copy to .env.local for development, and set the same values in your
# hosting provider's environment variables for production.
#
# .env.local is gitignored. Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both are SERVER-ONLY. Neither has the NEXT_PUBLIC_ prefix, so Next will not
# inline them into the client bundle — which is exactly the point. The
# service-role key bypasses row-level security; if it ever reaches a browser,
# every lead in the database is readable by anyone.
#
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Lead IP hashing ─────────────────────────────────────────────────────────
# Any long random string. Salts the SHA-256 of submitters' IP addresses so the
# stored hash cannot be reversed by hashing all ~4 billion IPv4 addresses.
# Generate one with: openssl rand -hex 32
# Changing this is safe; it only means old and new hashes stop matching.
LEAD_IP_SALT="change-me-to-a-long-random-string"

# ── Outbound email (contact form) ───────────────────────────────────────────
# Two messages are sent on every submission: a notification to us, and a
# branded auto-reply to the person who filled the form.
#
# The lead is written to Supabase BEFORE either send, so if these are unset or
# wrong the enquiry is still captured; it just arrives silently. The route logs
# a warning in that case.
#
# ── Setting this up with a Gmail account ──
# A normal Gmail password will NOT work here, and Google will reject the
# connection. You need an App Password, which requires 2-Step Verification:
#
#   1. Turn on 2-Step Verification:  myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:       myaccount.google.com/apppasswords
#      Name it anything ("BarrioVibe site"). Google shows a 16-character code.
#   3. Put that code in SMTP_PASS below, spaces removed.
#
# The App Password only grants SMTP access and can be revoked on its own
# without touching the account password.
SMTP_USER="barriovibe@gmail.com"
SMTP_PASS="your-16-char-app-password"

# Defaults suit Gmail; override only for another provider. Port 465 uses
# implicit TLS, 587 uses STARTTLS. The code derives which from the number.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Where enquiry notifications are delivered. Defaults to CONTACT.email in
# content/site.ts, so leave unset unless they should go somewhere else.
# CONTACT_NOTIFY_TO="barriovibe@gmail.com"

# The visible From line. Defaults to "BarrioVibe <SMTP_USER>".
#
# Gmail will not let you send as an address you do not own: authenticated SMTP
# can only use that account or a verified alias, and anything else is silently
# rewritten. So set this ONLY when moving to real domain mail (Google
# Workspace, Zoho, Fastmail) on barriovibe.com. No code changes are needed for
# that switch, just these variables.
# MAIL_FROM="BarrioVibe <hello@barriovibe.com>"
